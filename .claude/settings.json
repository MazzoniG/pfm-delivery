{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(./**)",
      "Edit(./**)",
      "Write(./**)",
      "Glob",
      "Grep",

      "Bash(pnpm install)",
      "Bash(pnpm install:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm run:*)",
      "Bash(pnpm -r:*)",
      "Bash(pnpm --filter:*)",
      "Bash(pnpm exec:*)",
      "Bash(pnpm dlx:*)",
      "Bash(pnpm view:*)",
      "Bash(pnpm why:*)",
      "Bash(pnpm outdated:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(npx vitest:*)",
      "Bash(npm view:*)",

      "Bash(node:*)",
      "Bash(tsc:*)",
      "Bash(npx prisma generate:*)",
      "Bash(npx prisma validate:*)",
      "Bash(npx prisma format:*)",
      "Bash(npx prisma migrate dev:*)",
      "Bash(npx prisma migrate deploy:*)",
      "Bash(npx prisma migrate status:*)",
      "Bash(npx prisma db seed:*)",

      "Bash(docker compose up:*)",
      "Bash(docker compose build:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose exec:*)",
      "Bash(docker compose down)",
      "Bash(docker ps:*)",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",

      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(rg:*)",
      "Bash(mkdir:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(psql:*)",

      "WebFetch(domain:registry.npmjs.org)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:www.prisma.io)",
      "WebFetch(domain:expressjs.com)",
      "WebFetch(domain:www.postgresql.org)",
      "WebFetch(domain:ui.shadcn.com)",
      "WebFetch(domain:tanstack.com)",
      "WebFetch(domain:vite.dev)",
      "WebFetch(domain:react.dev)",
      "WebSearch"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Write(./.env)",
      "Write(./**/.env)",
      "Read(~/.npmrc)",
      "Read(~/.docker/config.json)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",

      "Bash(rm -rf:*)",
      "Bash(sudo:*)",

      "Bash(git init:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git mv:*)",
      "Bash(git rm:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git merge:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git tag:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git rebase:*)",
      "Bash(gh repo delete:*)",
      "Bash(pnpm publish:*)",
      "Bash(npm publish:*)",
      "Bash(docker compose down -v:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker system prune:*)",
      "Bash(npx prisma migrate reset:*)",
      "Bash(npx prisma db push:*)",
      "Bash(wget:*)",

      "Write(./.claude/settings.json)",
      "Edit(./.claude/settings.json)",
      "Write(./.claude/agents/**)",
      "Edit(./.claude/agents/**)",
      "Write(./CLAUDE.md)",
      "Edit(./CLAUDE.md)",

      "Bash(cat ~/.npmrc:*)",
      "Bash(cat ~/.ssh/:*)",
      "Bash(cat ~/.aws/:*)",
      "Bash(cat ~/.docker/config.json:*)"
    ]
  },
  "env": {
    "NODE_ENV": "development"
  }
}
