{
  "name": "@pfm/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json && cp -R src/modules/insights/prompts dist/modules/insights/prompts",
    "start": "node dist/server.js",
    "test": "prisma generate && vitest run",
    "typecheck": "prisma generate && tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@pfm/contracts": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "express": "5.2.1",
    "pg": "^8.23.0",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@pfm/config": "workspace:*",
    "@prisma/config": "^7.10.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/express": "5.0.6",
    "@types/node": "24.10.1",
    "@types/pg": "^8.23.1",
    "@types/supertest": "6.0.3",
    "prisma": "7.10.0",
    "supertest": "7.2.2",
    "testcontainers": "^12.1.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
