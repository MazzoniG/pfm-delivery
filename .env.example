# Copy to .env. Loaded by the API, the Prisma CLI and the seed by walking up
# from the working directory; anything already exported wins over this file,
# and docker compose sets its own environment rather than reading it.
DATABASE_URL=postgresql://pfm:pfm@localhost:5432/pfm?schema=public
PORT=3000
LOG_LEVEL=info

# Seed is idempotent and deterministic, but gated so it never runs by accident.
SEED_ON_START=true

# Optional. Without it the AI insights report degrades to its SQL half,
# which is the whole point of that design — it must still be useful.
# compose passes this through from your .env, so `docker compose up` picks it up.
ANTHROPIC_API_KEY=

# The model is only asked to group merchant names by meaning — a small,
# well-specified task — so the cheapest current model is the right default
# rather than a concession. A larger one is a one-word change.
INSIGHTS_MODEL=claude-haiku-4-5

# The cost ceiling, stated in the two units that actually bound one call.
INSIGHTS_TIMEOUT_MS=15000
INSIGHTS_MAX_OUTPUT_TOKENS=2000
